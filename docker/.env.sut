# SUT-box sizing — the measured configuration. Values are the flat *what*
# from SUT-CONFIG.md ("Resource budgets", 50/50 cgroup split); TUNING.md has
# the why. PROPOSED until the Phase-D memory validation passes (see
# ENGINE-PREP-PLAN.md); if Phase D forces an asymmetric split, change
# SUT-CONFIG.md and this file in the same commit.
#
# Pass with: docker compose -f <file> --env-file docker/.env.sut ...
# (from the harness: also DOCKER_HOST=ssh://<sut-ip> — see tools/fleet_env.sh).

# --- Image pins ------------------------------------------------------------
SCYLLA_IMAGE=scylladb/scylla:2026.3.0-rc2
# Published-source build: knowack1/vector-store branch
# p99-fts-ingest-optimization @ 282d9efc (upstream master + FTS tunable env
# vars + optional inline ingest dispatch). Built on the harness,
# `docker save | ssh ... docker load`ed onto the SUT — not pullable from a
# registry.
#
# Supersedes 1.10.0-43-ge242fa3-arm64 (branch p99-fts-no-commit-threshold),
# which was erased with the instance store on 2026-09-07. This image is a
# strict superset: the one added knob, VECTOR_STORE_FTS_INLINE_INGEST,
# defaults to off, and with it unset the ingest path is byte-for-byte the
# previous behaviour. So an A/B's flag-off arm still measures stock.
VECTOR_STORE_IMAGE=scylladb/vector-store:1.10.0-44-g282d9efc-arm64
OPENSEARCH_IMAGE=opensearchproject/opensearch:3.8.0

# --- The 50/50 split (i8g.2xlarge: 8 vCPU / 64 GiB, ~5 GiB kept for OS) -----
# One engine stack at a time. Per side, not per process: the ScyllaDB side is
# two services (cluster + vector-store index), OpenSearch is one plus a
# deliberately idle "database slot" — every chart footer states this.

SCYLLA_SMP=4
SCYLLA_MEMORY=24G
# Dedicated cores: production poll-mode. The laptop needed 1; the SUT is a
# single-purpose box and 1 here would be a silent handicap.
SCYLLA_OVERPROVISIONED=0
SCYLLA_MEM_LIMIT=28g
SCYLLA_CPUS=4
SCYLLA_CPUSET=0-3

# 26 GiB in bytes. Phase D measured a 2.46 GiB vector-store RSS peak at 10%
# of enwiki; the linear x10 extrapolation is 24.4 GiB — under the <26 GiB
# keep-the-split rule but OVER the original 24 GiB in-process budget, whose
# breach is the silent-document-skipping failure mode. 26 GiB keeps 2 GiB to
# the 28 GiB cgroup cap; the scylla_index_complete gate still backstops it.
VS_MEMORY_LIMIT=27917287424
# 0 disables the compiled-in 10k-uncommitted-docs commit trigger, so commits
# are purely interval-driven (3 s) — parity with refresh_interval: 3s at every
# load level. DEVIATION FROM RELEASE BEHAVIOUR, disclosed on every chart.
VS_FTS_COMMIT_THRESHOLD=0
# Writer buffer parity. Unset, tantivy's IndexWriter takes MEMORY_BUDGET_NUM_
# BYTES_MIN = 15 MB PER THREAD (its floor); OpenSearch's Lucene counterpart,
# indices.memory.index_buffer_size, defaults to 10% of the 14 GiB heap =
# 1.4 GiB (1,503,238,553 B) node-total for the single shard. That ~25x gap
# made the vector-store run ~9x more segment merges and cost it ~24% build
# throughput on the laptop (results/fts-bottleneck-2026-08-27).
# 1.4 GiB / 4 worker threads = 375.8M B -> 376 MB/thread (the knob is decimal
# MB: config_manager.rs does megabytes * 1_000_000). 376 x 4 = 1,504 MB ~=
# the OpenSearch node total — the "equal total budget" reading, since
# memory_budget_per_thread is per-thread and index_buffer_size is a node sum.
# num_worker_threads = perf::num_workers() = tokio workers = available_
# parallelism = 4 here (VECTOR_STORE_THREADS unset, cpuset 4-7). The vector-
# store logs "N tantivy worker threads, M MB buffer per thread ..." at
# startup — the re-run gate reads M and N off that line, no assumption.
# NOT a release default: needs the tunables build above; public 1.10.0
# ignores it. tantivy floor is 15 -> the process refuses to start below it.
VS_FTS_WRITER_MEMORY_MB=376
VS_MEM_LIMIT=28g
VS_CPUS=4
VS_CPUSET=4-7

OS_HEAP=-Xms14g -Xmx14g
OS_MEM_LIMIT=28g
OS_CPUS=4
OS_CPUSET=4-7

# Fallback only — every service above pins its own set. Kept so a compose file
# that still reads ENGINE_CPUSET fails loudly toward the full engine range
# rather than silently unpinned.
ENGINE_CPUSET=0-7

# Single-purpose box: no devcontainer holding 9042, so no remap.
SCYLLA_HOST_PORT=9042
# Without this the driver on the harness discovers the SUT's docker-bridge IP
# (unroutable off-box) as the node address and every remote CQL session dies
# with NoHostAvailable. The vector-store still reaches the node: the host IP
# hairpins through the published 9042. Unset on the laptop, where the bridge
# IS reachable.
SCYLLA_BROADCAST_RPC=172.31.47.166
# Seastar's c-ares resolver cannot resolve the compose-network name
# 'vector-store' on this host (AL2023 resolv.conf: ndots:0 + EC2 search
# domain), so BM25 queries died with "Vector Store service address could not
# be fetched from DNS" while glibc in the same container resolved it fine.
# The published port on the box's own IP bypasses DNS entirely.
SCYLLA_VS_URI=http://172.31.47.166:16080
VS_HOST_PORT=16080
