# SUT-box sizing — the measured configuration. Values are the flat *what*
# from SUT-CONFIG.md ("Resource budgets", 50/50 cgroup split); TUNING.md has
# the why. PROPOSED until the Phase-D memory validation passes (see
# ENGINE-PREP-PLAN.md); if Phase D forces an asymmetric split, change
# SUT-CONFIG.md and this file in the same commit.
#
# Pass with: docker compose -f <file> --env-file docker/.env.sut ...
# (from the harness: also DOCKER_HOST=ssh://<sut-ip> — see tools/fleet_env.sh).

# --- Image pins ------------------------------------------------------------
SCYLLA_IMAGE=scylladb/scylla:2026.3.0-rc2
# Published-source build: knowack1/vector-store branch
# p99-fts-no-commit-threshold @ e242fa3b (upstream master + FTS tunable env
# vars). Built on the harness, `docker save | ssh ... docker load`ed onto the
# SUT — not pullable from a registry.
VECTOR_STORE_IMAGE=scylladb/vector-store:1.10.0-43-ge242fa3-arm64
OPENSEARCH_IMAGE=opensearchproject/opensearch:3.8.0

# --- The 50/50 split (i8g.2xlarge: 8 vCPU / 64 GiB, ~5 GiB kept for OS) -----
# One engine stack at a time. Per side, not per process: the ScyllaDB side is
# two services (cluster + vector-store index), OpenSearch is one plus a
# deliberately idle "database slot" — every chart footer states this.

SCYLLA_SMP=4
SCYLLA_MEMORY=24G
# Dedicated cores: production poll-mode. The laptop needed 1; the SUT is a
# single-purpose box and 1 here would be a silent handicap.
SCYLLA_OVERPROVISIONED=0
SCYLLA_MEM_LIMIT=28g
SCYLLA_CPUS=4
SCYLLA_CPUSET=0-3

# 26 GiB in bytes. Phase D measured a 2.46 GiB vector-store RSS peak at 10%
# of enwiki; the linear x10 extrapolation is 24.4 GiB — under the <26 GiB
# keep-the-split rule but OVER the original 24 GiB in-process budget, whose
# breach is the silent-document-skipping failure mode. 26 GiB keeps 2 GiB to
# the 28 GiB cgroup cap; the scylla_index_complete gate still backstops it.
VS_MEMORY_LIMIT=27917287424
# 0 disables the compiled-in 10k-uncommitted-docs commit trigger, so commits
# are purely interval-driven (3 s) — parity with refresh_interval: 3s at every
# load level. DEVIATION FROM RELEASE BEHAVIOUR, disclosed on every chart.
VS_FTS_COMMIT_THRESHOLD=0
VS_MEM_LIMIT=28g
VS_CPUS=4
VS_CPUSET=4-7

OS_HEAP=-Xms14g -Xmx14g
OS_MEM_LIMIT=28g
OS_CPUS=4
OS_CPUSET=4-7

# Fallback only — every service above pins its own set. Kept so a compose file
# that still reads ENGINE_CPUSET fails loudly toward the full engine range
# rather than silently unpinned.
ENGINE_CPUSET=0-7

# Single-purpose box: no devcontainer holding 9042, so no remap.
SCYLLA_HOST_PORT=9042
# Without this the driver on the harness discovers the SUT's docker-bridge IP
# (unroutable off-box) as the node address and every remote CQL session dies
# with NoHostAvailable. The vector-store still reaches the node: the host IP
# hairpins through the published 9042. Unset on the laptop, where the bridge
# IS reachable.
SCYLLA_BROADCAST_RPC=172.31.47.166
VS_HOST_PORT=16080
