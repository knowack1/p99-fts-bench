# Pinned image tags and sizing knobs for the local benchmark stack.
# Pass with: docker compose -f <file> --env-file docker/.env ...
# (the Makefile targets already do).

# --- Image pins ------------------------------------------------------------
# Pinned, not :latest — the manifest writer records these tags so a chart can
# be traced back to the exact build it was produced on. All three are
# multi-arch (linux/amd64 + linux/arm64).
SCYLLA_IMAGE=scylladb/scylla:2026.3.0-rc2
VECTOR_STORE_IMAGE=scylladb/vector-store:1.10.0-p99-tunable2
OPENSEARCH_IMAGE=opensearchproject/opensearch:3.8.0

# --- Sizing knobs ----------------------------------------------------------
# EVERYTHING BELOW IS A LAPTOP-SIMULATION VALUE. It exists so the pipeline can
# be shaken out on a developer machine and so both engines are squeezed
# symmetrically while doing so. These are NOT the benchmark's tuning: the
# published runs must replace every value here with the tuned, documented
# settings for the real (i3en-class) hardware, per the fairness rules in the
# concept doc §7. Do not quote a number produced with these defaults.

# ScyllaDB shard count and per-node memory. --overprovisioned is set in the
# compose file because a laptop is never a dedicated Scylla host.
SCYLLA_SMP=3
SCYLLA_MEMORY=2G

# vector-store index memory budget, in BYTES (VECTOR_STORE_MEMORY_LIMIT).
# Leave blank to omit the variable entirely, in which case the service falls
# back to its own default (available memory minus a safety buffer).
VS_MEMORY_LIMIT=6442450944

# OpenSearch JVM heap. Sized against the SUM of the two ScyllaDB-side
# in-process budgets (SCYLLA_MEMORY 2G + VS_MEMORY_LIMIT 2 GiB = 4 GiB), not
# against either one alone. See the budget-parity note below.
OS_HEAP=-Xms4g -Xmx4g

# --- Budget parity: per side, not per process ------------------------------
# ScyllaDB FTS is architecturally two services (the cluster plus the
# vector-store holding the index); OpenSearch is one. Giving each *process* an
# equal budget would hand the ScyllaDB side twice the hardware, so the budgets
# below are equal per SIDE:
#
#   ScyllaDB side: 3 + 2 = 5 cpus, 4g + 4g = 8g caps, 2G + 2 GiB in-process
#   OpenSearch:        5 cpus,          8g cap,       4 GiB heap
#
# That is the comparison an operator actually faces — they pay for the whole
# deployment, not for one process of it. Every chart footer states the ratio.
#
# Container caps stay deliberately above the in-process budgets: the cap is a
# blast-radius limit, not the tuning knob. Docker kills the container on
# breach, which would silently truncate a series, so leave headroom.
SCYLLA_MEM_LIMIT=4g
SCYLLA_CPUS=3
VS_MEM_LIMIT=8g
VS_CPUS=6
OS_MEM_LIMIT=8g
OS_CPUS=5

# Which host CPUs the engine containers may run on. `cpus` above is a quota;
# this is the actual placement. Both must be set: a quota alone lets the
# scheduler move an engine thread onto the 2.5 GHz LP-E cores (cpu20/21),
# which is a 1.92x frequency step relative to the 4.8 GHz P-cores and would
# land in the latency tail as if it were engine behaviour. 0-11 is the six
# whole P-cores; the load generator is pinned to the E-cores (12-19) and the
# OS and Docker daemon keep 20-21. See results/*/ENVIRONMENT.md.
#
# Note that `taskset` on the docker CLI does NOT pin the container — the
# container is a child of the daemon, not of the CLI process. This variable is
# the only thing that pins it.
ENGINE_CPUSET=0-11

# Host-side port bindings. Overridden away from the defaults when a devcontainer
# port-forward already holds 9042/6080; the in-container ports never change.
SCYLLA_HOST_PORT=19042
VS_HOST_PORT=16080
